{
  "name": "@plataforma/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../config/vitest.mjs",
    "test:coverage": "vitest run --config ../config/vitest.mjs --coverage --coverage.thresholds.statements=90 --coverage.thresholds.lines=90 --coverage.thresholds.functions=90",
    "lint": "eslint .",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@plataforma/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.5"
  }
}
