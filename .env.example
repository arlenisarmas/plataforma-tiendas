# Public: available to browsers. Supabase staging/local URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URLs and platform hostname (without protocol).
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_STOREFRONT_URL=
NEXT_PUBLIC_PLATFORM_DOMAIN=
# Server only: never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# GitHub secrets for staging deployment and CLI.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Server secrets: revalidation, editor previews, cart signatures, cron.
REVALIDATE_SECRET=
PREVIEW_SECRET=
CART_COOKIE_SECRET=
CRON_SECRET=
# Mercado Pago OAuth and verified webhook signature (test credentials initially).
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=
MERCADOPAGO_WEBHOOK_SECRET=
# Transactional email and custom domains. Server only.
RESEND_API_KEY=
EMAIL_FROM=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_STOREFRONT_PROJECT_ID=
# Error monitoring: public DSNs; upload token stays in CI/server.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
